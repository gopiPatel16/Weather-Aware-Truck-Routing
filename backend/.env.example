# Copy to backend/.env for local development. NEVER commit the real file.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Free key, no credit card: https://developer.tomtom.com  (routing + geocoding)
TOMTOM_API_KEY=

# open_meteo (real forecast) | mock (clearly labelled synthetic demo weather)
WEATHER_PROVIDER=open_meteo
WEATHER_MOCK_SCENARIO=plains_storm
# Optional paid Open-Meteo plan key (the free tier is non-commercial)
OPEN_METEO_API_KEY=

LOG_LEVEL=INFO
