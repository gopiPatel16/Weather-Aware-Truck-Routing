# Basemap style (MapLibre style JSON). Default: OpenFreeMap "Positron" (no key needed).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Serve fixtures from mock/ instead of calling the backend (set to 1 for offline UI work).
VITE_USE_MOCK=0
# Backend the dev server proxies /api to.
# VITE_API_TARGET=http://localhost:8000
